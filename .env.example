# =============================================================================
# DevPilot Local Development Environment
# =============================================================================
# Copy to .env and fill in for LOCAL DEV ONLY.
# In production, all secrets come from Azure Key Vault via Managed Identity.
# =============================================================================

# --- Azure ---
AZURE_SUBSCRIPTION_ID=71548670-1c08-45be-a4d8-5fccfe411f75
AZURE_TENANT_ID=8da0d0be-1fb3-449d-a94f-a906089ba585
AZURE_LOCATION=eastus2

# --- Azure AI Foundry ---
AI_FOUNDRY_ENDPOINT=https://ais-devpilot-dev-dev-pbrv5.services.ai.azure.com/
AI_FOUNDRY_MODEL_DEPLOYMENT=gpt-4o-mini

# --- Azure ML ---
AZURE_ML_ENDPOINT=https://your-ml-endpoint.eastus2.inference.ml.azure.com/score

# --- Azure App Configuration ---
AZURE_APP_CONFIG_ENDPOINT=https://appcfg-devpilot-dev-dev-pbrv5.azconfig.io

# --- Azure Key Vault ---
AZURE_KEY_VAULT_URI=https://kvdevpilotdevdevpbrv5.vault.azure.net/

# --- Azure Cosmos DB ---
COSMOS_ENDPOINT=https://cosmos-devpilot-dev-dev-pbrv5.documents.azure.com:443/
COSMOS_DATABASE=devpilot
COSMOS_CONTAINER=pipeline_runs

# --- Storage (Queue worker) ---
STORAGE_ACCOUNT_NAME=stdevpilotdevdevpbrv5

# --- Azure Container Registry ---
ACR_NAME=acrdevpilotdev4056
CONTAINER_IMAGE=acrdevpilotdev4056.azurecr.io/devpilot:latest

# --- GitHub App ---
GITHUB_APP_ID=3971921
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/devpilot.pem
GITHUB_WEBHOOK_SECRET=

# --- Logging ---
LOG_LEVEL=INFO
APPLICATIONINSIGHTS_CONNECTION_STRING=

# =============================================================================
# DevPilot Local Development Environment
# =============================================================================
# Copy to .env and fill in for LOCAL DEV ONLY.
# In production, all secrets come from Azure Key Vault via Managed Identity.
# =============================================================================

# --- Azure ---
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_LOCATION=eastus2

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- Azure ML ---
AZURE_ML_ENDPOINT=https://your-ml-endpoint.eastus2.inference.ml.azure.com/score
AZURE_ML_API_KEY=

# --- Azure App Configuration ---
AZURE_APP_CONFIG_ENDPOINT=https://appcfg-devpilot.azconfig.io

# --- Azure Key Vault ---
AZURE_KEY_VAULT_URI=https://kv-devpilot-dev.vault.azure.net/

# --- Azure Cosmos DB ---
COSMOS_ENDPOINT=https://cosmos-devpilot.documents.azure.com:443/
COSMOS_DATABASE=devpilot
COSMOS_CONTAINER=pipeline_runs

# --- GitHub App ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/devpilot.pem
GITHUB_WEBHOOK_SECRET=

# --- Logging ---
LOG_LEVEL=INFO
APPLICATIONINSIGHTS_CONNECTION_STRING=

# =============================================================================
# DevPilot .gitignore
# =============================================================================

# --- Secrets / Environment ---
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
local.settings.json

# --- Terraform ---
**/.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup
*.tfplan
*.tfvars
!*.tfvars.example
.terraform.lock.hcl
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
venv/
.venv/
env/

# --- Node / Frontend ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp.*
.next/
out/
.cache/

# --- Azure Functions ---
bin/
obj/
.azurefunctions/

# --- IDE ---
.vscode/
!.vscode/settings.json.example
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store

# --- OS ---
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Logs ---
*.log
logs/

# --- Local model artifacts ---
*.pkl
*.joblib
*.onnx
models/local/

# --- Misc ---
tmp/
.tmp/
